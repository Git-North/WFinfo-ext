<?xml version="1.0" encoding="utf-8"?>
<!-- tests/run.ts uses this file for `dotnet test` with coverage (coverlet). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover</Format>
          <Include>[WFInfo.Headless]*</Include>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
