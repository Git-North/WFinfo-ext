<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the headless runner (test code only, never shipped). Run through
    tests/run.ts: it gives the test process its own app-data folder. A plain
    `dotnet test` skips the tests that need that folder.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <HeadlessOut>$(MSBuildThisFileDirectory)../../headless/bin/$(Configuration)/net9.0/</HeadlessOut>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../headless/WFInfo.Headless.csproj" />
  </ItemGroup>

  <!--
    macOS: the Rust layout library is loaded from the folder of the runner's
    DLL, which here is the test output. Delete first, so the copy gets a new
    inode (macOS keeps the old code signature of an overwritten file). The tests
    run the Swift helper from the runner's own output folder.
  -->
  <Target Name="CopyMacNatives" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Delete Files="$(OutDir)libwfinfo_layout.dylib" />
    <Copy SourceFiles="$(HeadlessOut)libwfinfo_layout.dylib" DestinationFolder="$(OutDir)" />
    <WriteLinesToFile File="$(OutDir)headless-out.txt" Lines="$(HeadlessOut)" Overwrite="true" />
  </Target>

</Project>
