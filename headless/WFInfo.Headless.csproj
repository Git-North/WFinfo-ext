<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>WFInfo</RootNamespace>
    <AssemblyName>WFInfo.Headless</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Legacy code uses BinaryFormatter and Win32-only APIs behind runtime guards. -->
    <NoWarn>$(NoWarn);SYSLIB0011;CA1416;CS0649;CS0169;CS0067</NoWarn>
    <StartupObject>WFInfo.HeadlessProgram</StartupObject>
    <!-- macOS (Homebrew) may ship only a newer .NET runtime; run on it when 9 is absent. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- System.Drawing.Common >= 7 throws PlatformNotSupportedException on Linux
         even with EnableUnixSupport (opt-in removed upstream); 6.0.0 is the last
         line with libgdiplus support and loads fine from a net9.0 app. -->
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <!--
    Headless runner: links the REAL WFInfo core sources (no copies, no mocks).
    The .NET Framework / WPF / WinForms / Win32 surfaces live in files that are
    intentionally NOT linked here; their compile-time shape is provided by
    headless/Platform/*.cs so the shared sources type-check on net9.0/Linux.
  -->
  <ItemGroup>
    <Compile Include="..\WFInfo\Ocr.cs" Link="Shared\Ocr.cs" />
    <Compile Include="..\WFInfo\Data.cs" Link="Shared\Data.cs" />
    <Compile Include="..\WFInfo\LanguageProcessing\*.cs" Link="Shared\LanguageProcessing\%(Filename)%(Extension)" />
    <Compile Include="..\WFInfo\Services\TesseractService.cs" Link="Shared\TesseractService.cs" />
    <Compile Include="..\WFInfo\Services\HDRDetection\IHDRDetectorService.cs" Link="Shared\IHDRDetectorService.cs" />
    <Compile Include="..\WFInfo\Services\WindowInfo\IWindowInfoService.cs" Link="Shared\IWindowInfoService.cs" />
    <Compile Include="..\WFInfo\Services\WarframeProcess\IProcessFinder.cs" Link="Shared\IProcessFinder.cs" />
    <Compile Include="..\WFInfo\Services\Screenshot\IScreenshotService.cs" Link="Shared\IScreenshotService.cs" />
    <Compile Include="..\WFInfo\Settings\ApplicationSettings.cs" Link="Shared\ApplicationSettings.cs" />
    <Compile Include="..\WFInfo\Settings\IReadOnlyApplicationSettings.cs" Link="Shared\IReadOnlyApplicationSettings.cs" />
    <Compile Include="..\WFInfo\Tests\OCRTestRunner.cs" Link="Shared\OCRTestRunner.cs" />
    <Compile Include="..\WFInfo\Tests\TestModels.cs" Link="Shared\TestModels.cs" />
    <Compile Include="..\WFInfo\Tests\ThemeTestRunner.cs" Link="Shared\ThemeTestRunner.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Platform\*.cs" />
    <Compile Include="Scan\*.cs" />
    <Compile Include="macos\*.cs" />
    <Compile Include="OverlayPin.cs" />
  </ItemGroup>

  <!--
    macOS: compile the Swift helper (Vision OCR, displays/windows, ScreenCaptureKit
    capture, global hotkey) next to the runner. Other hosts skip this target.
  -->
  <PropertyGroup>
    <!-- RecognizeTextRequest (Swift Vision API) needs macOS 15. swiftc ignores
         MACOSX_DEPLOYMENT_TARGET, so the target triple carries the minimum. -->
    <MacHelperMinimumOS>15.0</MacHelperMinimumOS>
    <MacHelperArch Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">arm64</MacHelperArch>
    <MacHelperArch Condition="'$(MacHelperArch)' == ''">x86_64</MacHelperArch>
  </PropertyGroup>

  <Target Name="BuildMacHelper" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="$(MSBuildThisFileDirectory)macos/wfinfo-mac.swift;$(MSBuildThisFileFullPath)"
          Outputs="$(OutDir)wfinfo-mac">
    <Exec Command="swiftc -O -target $(MacHelperArch)-apple-macos$(MacHelperMinimumOS) -o &quot;$(OutDir)wfinfo-mac&quot; &quot;$(MSBuildThisFileDirectory)macos/wfinfo-mac.swift&quot;" />
  </Target>

  <!--
    macOS: build the Rust reward layout (headless/macos/layout, a cdylib that
    VisionRewardScan calls through [DllImport]) and copy it next to the
    runner. Cargo's output stays under obj/. Other hosts skip this target, so
    Linux and Windows builds need no Rust toolchain.
  -->
  <ItemGroup>
    <RustLayoutSource Include="$(MSBuildThisFileDirectory)macos/layout/src/**/*.rs;$(MSBuildThisFileDirectory)macos/layout/Cargo.toml;$(MSBuildThisFileDirectory)macos/layout/Cargo.lock" />
  </ItemGroup>

  <Target Name="BuildRustLayout" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))"
          Inputs="@(RustLayoutSource)"
          Outputs="$(OutDir)libwfinfo_layout.dylib">
    <Exec Command="cargo build --release --locked --manifest-path &quot;$(MSBuildThisFileDirectory)macos/layout/Cargo.toml&quot;"
          EnvironmentVariables="CARGO_TARGET_DIR=$(MSBuildThisFileDirectory)obj/rust-layout" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)obj/rust-layout/release/libwfinfo_layout.dylib" DestinationFolder="$(OutDir)" />
  </Target>

  <!-- macOS: `dotnet publish` copies only the build's .NET outputs, so copy the
       helper and the Rust layout library into the publish folder too. Other
       hosts skip this target. -->
  <Target Name="PublishMacHelper" AfterTargets="Publish" DependsOnTargets="BuildMacHelper;BuildRustLayout"
          Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Copy SourceFiles="$(OutDir)wfinfo-mac;$(OutDir)libwfinfo_layout.dylib" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Every OS with a Rust toolchain: build the overlay plugin client
    (headless/native/overlay, a cdylib that OverlayPin.cs calls through
    [DllImport]) and copy it next to the runner. Without cargo the target is
    skipped, the runner builds as before, and overlay pinning reports PLG-019.
    macOS: `brew install rust`; Linux: cargo comes from the flake. A build
    that cargo starts and fails does fail this build.
    -p:BuildOverlayClient=false turns the target off.
  -->
  <PropertyGroup>
    <BuildOverlayClient Condition="'$(BuildOverlayClient)' == ''">true</BuildOverlayClient>
    <RustOverlayDirectory>$(MSBuildThisFileDirectory)native/overlay</RustOverlayDirectory>
    <RustOverlayLibrary Condition="$([MSBuild]::IsOSPlatform('OSX'))">libwfinfo_overlay.dylib</RustOverlayLibrary>
    <RustOverlayLibrary Condition="$([MSBuild]::IsOSPlatform('Windows'))">wfinfo_overlay.dll</RustOverlayLibrary>
    <RustOverlayLibrary Condition="'$(RustOverlayLibrary)' == ''">libwfinfo_overlay.so</RustOverlayLibrary>
  </PropertyGroup>

  <ItemGroup>
    <RustOverlaySource Include="$(MSBuildThisFileDirectory)native/overlay/src/**/*.rs;$(MSBuildThisFileDirectory)native/overlay/Cargo.toml;$(MSBuildThisFileDirectory)native/overlay/Cargo.lock" />
  </ItemGroup>

  <Target Name="FindCargo" Condition="'$(BuildOverlayClient)' == 'true'">
    <Exec Command="cargo --version" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="CargoExitCode" />
    </Exec>
    <Message Condition="'$(CargoExitCode)' != '0'" Importance="high"
             Text="cargo not found: building without the overlay plugin client (overlay pinning stays off)." />
  </Target>

  <!-- The order matters: CompileRustOverlay's condition needs FindCargo's
       result, and MSBuild reads a target's condition before it runs that
       target's own dependencies. -->
  <Target Name="BuildRustOverlay" AfterTargets="Build" DependsOnTargets="FindCargo;CompileRustOverlay" />

  <!-- WorkingDirectory: rustup reads rust-toolchain.toml from there.
       crate-type cdylib: the crate is also an rlib for its tests, and cargo
       drops LTO when it builds both. -->
  <Target Name="CompileRustOverlay"
          Condition="'$(BuildOverlayClient)' == 'true' And '$(CargoExitCode)' == '0'"
          Inputs="@(RustOverlaySource)"
          Outputs="$(OutDir)$(RustOverlayLibrary)">
    <Exec Command="cargo rustc --release --locked --lib --crate-type cdylib" WorkingDirectory="$(RustOverlayDirectory)"
          EnvironmentVariables="CARGO_TARGET_DIR=$(MSBuildThisFileDirectory)obj/rust-overlay" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)obj/rust-overlay/release/$(RustOverlayLibrary)" DestinationFolder="$(OutDir)" />
  </Target>

  <!-- `dotnet publish` copies only the build's .NET outputs. -->
  <Target Name="PublishRustOverlay" AfterTargets="Publish" DependsOnTargets="BuildRustOverlay">
    <Copy Condition="Exists('$(OutDir)$(RustOverlayLibrary)')" SourceFiles="$(OutDir)$(RustOverlayLibrary)"
          DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Drawing.EnableUnixSupport" Value="true" />
  </ItemGroup>

</Project>
